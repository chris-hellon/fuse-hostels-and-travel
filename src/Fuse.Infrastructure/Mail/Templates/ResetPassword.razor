@* Legacy's "Reset Password" (Forgot password? on the website or the back office). *@
<EmailFrame Brand="Brand" Title="Reset your password" Preheader="Choose a new password for your account"
            ActionIntro="Forgotten your password?" ActionText="Reset Password" ActionUrl="@Link">
    <tr>
        <td align="left" style="@(EmailStyles.Body) padding-top: 10px;">
            <p style="@EmailStyles.Paragraph">Hi@(string.IsNullOrWhiteSpace(FirstName) ? "" : $" {FirstName}"), someone asked to reset the password for your @Brand.TenantName account. Choose a new one with the button below. The link works once, for 24 hours.</p>
            <p style="@EmailStyles.Paragraph">If you didn't ask for this, just ignore this email: your password won't change.</p>
        </td>
    </tr>
    <SignOff />
</EmailFrame>

@code {
    [Parameter, EditorRequired] public MailBrand Brand { get; set; } = null!;
    [Parameter] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public string Link { get; set; } = "";
}
