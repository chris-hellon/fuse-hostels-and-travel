@page "/our-story"
@inherits SitePage

<SeoHead Page="Page" PageName="Our Story" Keywords="our story, hostel brand, backpacking, travel community" />

<section id="headerBanner">
    <HeaderBanner Headings="BannerHeadings()" ImageUrl="https://travaloudcdn.azureedge.net/fuse/assets/images/our-story.jpg" Style="background-position-y: 50%;">
        <NavPills Items="Pills" />
    </HeaderBanner>
</section>
@if (Page is not null)
{
    <section id="who-we-are" class="overflow-hidden inherit-sticky-parent">
        @* Legacy's page script restyled this diagonal (-50deg, white to 70%). *@
        <RoundedImageSection Titles="@(["WHO WE ARE"])" ImageUrl="https://travaloudcdn.azureedge.net/fuse/assets/images/fuse-purple-logo.webp"
                             BackgroundStyle="background-image: -webkit-linear-gradient(-50deg, rgb(255, 255, 255) 70%, rgb(209, 172, 0) 50%);">
            <Body>
                @* Legacy wrapped this rich text in a <p>, which browsers turn into an empty paragraph either side. *@
                <p></p>
                <p>What's up world explorers! FUSE is not just another hostel, we're your home away from home in Vietnam. Our aim is to offer the most epic locations with some kick ass social spaces and cool activities, right on your doorstep.</p>
                <p>We might be super fresh to the hostel scene as a company, but this isn’t our first rodeo. Our team is made up of local legends and well-travelled wanderers who are experts at creating awesome experiences that are all created with the aim to chill, meet some new mates and dip your toes into the local adventure that awaits!</p>
                <p></p>
            </Body>
            <Ovals>
                <OvalContainer Id="aboutPageIntroductionOvals1" Top="15" Right="-28" />
                <OvalContainer Id="aboutPageIntroductionOvals2" Bottom="15" Right="18" />
            </Ovals>
        </RoundedImageSection>
    </section>
    <section id="what-we-do" class="overflow-hidden bg-light">
        <RoundedImageSection Titles="@(["WHAT WE DO"])" ImageUrl="https://travaloudcdn.azureedge.net/fuse/assets/images/what-we-do.jpg" Swap="true">
            <Body>
                <p></p>
                <p>At FUSE Hostels and Travel, we offer so much more than just a bed to lay your head. Our hostels are stunning spaces to meet people from all over the world, to experience the vibrant local culture of Vietnam, plus we can guarantee an outrageously good time! Our goal is to make your stay nothing short of epic, from start to finish.</p>
                <p></p>
            </Body>
            <Ovals>
                <OvalContainer Id="aboutPageAboutOvals1" Top="-40" Left="-20" />
                <OvalContainer Id="aboutPageAboutOvals2" Bottom="-40" Right="-20" />
            </Ovals>
        </RoundedImageSection>
    </section>
    <section id="our-core-values">
        <div class="container-fluid p-0 m-0 position-relative">
            <SectionIntro Title="OUR CORE VALUES" Class="container pt-8 text-center ovals-container-parent">
                <p>
                    At FUSE Hostels and Travel, we take our values seriously. We believe that every guest who stays with us deserves to have an incredible experience that's full of adventure, fun, and connecting with locals and other travellers, all within a safe and secure environment.
                </p>
            </SectionIntro>
            <div class="container pb-8 pt-5">
                @* Alternating sides; the right-hand ones tuck up beside the one before on desktop. *@
                @for (var i = 0; i < CoreValues.Length; i++)
                {
                    var (title, colour, text) = CoreValues[i];
                    var right = i % 2 == 1;
                    <div class="@($"row g-lg-10{(i < CoreValues.Length - 1 ? " mb-3 mb-lg-0" : "")}")">
                        <div class="@($"col-lg-6 {(right ? "offset-lg-6 " : "")}has-parallax-scroll")">
                            <h4 class="@($"tilted display-6 {(right ? "mt-lg-n5 " : "")}bg-{colour} {(i == 0 ? "" : "mt-4 ")}mb-4 mb-lg-3")">@title</h4>
                            @((MarkupString)text)
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <JoinOurCrewBanner />
}
else
{
    @* Arriving from another page: its content is loading. *@
    <PageSkeleton />
}

@code {
    private static readonly (string Title, string Colour, string Text)[] CoreValues =
    [
        ("Adventure", "primary", "<p>Adventure is at the heart of everything we do, and as a world traveller, we’re sure it’s important to you too. We love exploring new places, trying new things, and pushing our limits, and we want to share that sense of excitement and discovery with you.</p><p>Let’s go climb a mountain, try a new street food, or dive into a crystal-clear ocean…we're always up for an adventure!</p>"),
        ("Fun", "mustard", "<p>We believe that life is meant to be enjoyed, don’t you? We want to make sure that when you stay with us, you have such a ridiculously good time that FUSE Hostels becomes an integral part of your travel story. Whether it's dancing the night away, jumping on one of our unique experiences around town, or just chilling with new friends poolside or at the beach, we've got you covered.</p>"),
        ("Connection", "red", "<p>We know you’re not just looking to connect to our WIFI… you want to connect with the local culture, with other travellers, and with yourself. We’ve done a lot of experimenting to ensure that the experiences you have when you stay at FUSE Hostels are the highlight of your trip! Get to know the local area and people on our bicycle tours and cooking classes, and let's not forget about the connections you'll make with other guests over a cold beer or sharing your snaps from your day out adventuring. Come for the vibe, stay for the friends at FUSE!</p>"),
        ("Community", "light-pink", "<p>At FUSE Hostels and Travel, we're more than just a place to stay. We're a community of adventure-seekers, fun-lovers and mates. We can't wait to welcome you to Vietnam, learn some of the language, hang out in our vibrant neighbourhoods, meet the friendly locals, and  of course come hang with the FUSE crew.<br />So, have you packed your bags yet?</p>"),
    ];

    private static readonly (string, string)[] Pills = [("WHO WE ARE", "who-we-are"), ("WHAT WE DO", "what-we-do"), ("OUR CORE VALUES", "our-core-values")];

    protected override DefaultIdType PageId => SitePages.OurStory;
}
