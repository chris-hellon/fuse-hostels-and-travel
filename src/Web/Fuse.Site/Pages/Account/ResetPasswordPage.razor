@page "/reset-password"

@* The link emailed by "Forgot your password?": choose a new password (the link is the proof), then sign in. *@

<SeoHead PageName="Reset Password" NoIndex="true" />

<LegalPage Id="resetPassword" Title="RESET PASSWORD">
    <div class="account-empty">
        @if (_done)
        {
            <i class="fas fa-circle-check account-empty__icon" aria-hidden="true"></i>
            <h2 class="display-6">ALL SET</h2>
            <p>Your password has been changed. Sign in with your new password.</p>
            <button type="button" class="btn btn-primary" @onclick="Dialogs.OpenSignIn">Sign In</button>
        }
        else if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
        {
            <h2 class="display-6">THAT DIDN'T WORK</h2>
            <p>This link is incomplete. Open it straight from the email, or ask for a new one from "Forgot your password?" when you sign in.</p>
            <button type="button" class="btn btn-primary" @onclick="Dialogs.OpenSignIn">Sign In</button>
        }
        else
        {
            <form class="reset-password text-start" novalidate @onsubmit="SubmitAsync">
                <p class="mb-4">Choose a new password for your account.</p>
                <OutlineInput Id="ResetPassword_New" Label="New password" Class="mb-4" @bind-Value="_password" type="password" autocomplete="new-password" />
                <Validation Message="@_passwordError" Style="@null" />
                <OutlineInput Id="ResetPassword_Confirm" Label="Confirm new password" Class="mb-4" @bind-Value="_confirm" type="password" autocomplete="new-password" />
                <Validation Message="@_confirmError" Style="@null" />
                @if (_error is not null)
                {
                    <p class="small text-danger mb-3" role="alert">@_error</p>
                }
                <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">@(_busy ? "Saving…" : "Reset password")</button>
            </form>
        }
    </div>
</LegalPage>

@code {
    [Inject] private IApi Api { get; set; } = null!;
    [CascadingParameter] private ISiteDialogs Dialogs { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "user")] private string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] private string? Token { get; set; }

    private string _password = "", _confirm = "";
    private string? _error, _passwordError, _confirmError;
    private bool _busy, _done;

    private async Task SubmitAsync()
    {
        _passwordError = _password.Length < Contracts.Identity.PasswordRules.MinimumLength ? $"The New password must be at least {Contracts.Identity.PasswordRules.MinimumLength} characters long." : null;
        _confirmError = _confirm != _password ? "Passwords do not match." : null;
        if (_passwordError is not null || _confirmError is not null)
            return;

        (_busy, _error) = (true, null);
        try
        {
            await Api.Send(new Contracts.Identity.ResetPassword(UserId!, Token!, _password, _confirm));
            _done = true;
        }
        catch (RequestValidationException validation)
        {
            _passwordError = string.Join(" ", validation.Errors.SelectMany(e => e.Value));
        }
        catch (AppException failure)
        {
            _error = failure.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
