@page "/join-our-crew/{Id:guid}"
@inject IApi Api
@inject NavigationManager Navigation

@* Legacy JoinOurCrew/Index with a vacancy chosen: "APPLY NOW", the position and where, its description beside the
   application form. *@

@if (Vacancy is { } vacancy)
{
    <SeoHead PageName="@($"Apply: {vacancy.JobTitle}")" Parent="@(("Join Our Crew", "/join-our-crew"))"
             MetaDescription="@($"Apply to join the Fuse Hostels & Travel crew as {vacancy.JobTitle} in {vacancy.Location}.")" />

    <section id="getInTouch" class="bg-light overflow-hidden position-relative">
        <div class="container-fluid">
            <div class="container pt-8 pb-8">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-12 has-parallax-scroll">
                        <h1 class="display-3 mb-4">APPLY NOW</h1>
                        <div class="card mt-5">
                            <div class="card-body p-4 p-lg-5">
                                <div class="d-flex justify-content-center">
                                    <h4 class="tilted display-6">@vacancy.JobTitle</h4>
                                </div>
                                <div class="d-flex justify-content-center mb-3">
                                    <h5><i class="fa-solid fa-location-dot text-primary me-2" aria-hidden="true"></i>@vacancy.Location</h5>
                                </div>
                                <hr class="hr" />
                                <div class="row gx-lg-7 gy-5">
                                    <div class="col-lg-6 text-start">
                                        @((MarkupString)(vacancy.Description ?? ""))
                                    </div>
                                    <div class="col-lg-6">
                                        @if (vacancy.ApplyUrl is { } elsewhere)
                                        {
                                            <p class="text-start">Applications for this position are taken here:</p>
                                            <a class="btn btn-primary d-block w-100" href="@elsewhere" target="@(elsewhere.StartsWith("mailto:") ? null : "_blank")" rel="noopener">Apply Now</a>
                                        }
                                        else
                                        {
                                            <JobApplicationForm VacancyId="vacancy.Id" />
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a class="d-inline-block mt-5" href="/join-our-crew#available-positions"><i class="fas fa-arrow-left-long me-2" aria-hidden="true"></i>All positions</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    @* Arriving from another page: the position is loading. *@
    <section class="bg-light page-loading-section">
        <LoadingMessage Text="Loading the position…" />
    </section>
}

@code {
    [Parameter] public DefaultIdType Id { get; set; }

    [PersistentState] public SiteJobVacancy? Vacancy { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Vacancy?.Id == Id)
            return;
        Vacancy = null; // from another position: loading, not the last one
        try
        {
            Vacancy = await Api.Send(new GetSiteJobVacancy(Id));
        }
        catch (NotFoundException)
        {
            Navigation.NotFound();
        }
    }
}
