@page "/basket"
@implements IDisposable
@inject IApi Api

@* Legacy /basket: the tours in the basket with a summary and Proceed To Checkout. The basket lives in the browser,
   so this fills in once the page is interactive; prices and availability come from the server. *@

<SeoHead PageName="Basket" />

<section class="bg-light">
    <div class="container py-5">
        <div class="card basket-card">
            <div class="row g-0">
                <div class="col-lg-8">
                    <div class="p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h1 class="fw-bold mb-0 text-black display-3">Basket</h1>
                            <h6 class="mb-0 text-muted">@($"{Basket.Count} item{(Basket.Count == 1 ? "" : "s")}")</h6>
                        </div>
                        <hr class="my-4" />
                        @if (!Basket.Loaded || (Basket.Count > 0 && _quote is null))
                        {
                            <LoadingMessage Text="Loading your basket…" />
                        }
                        else if (Basket.Count == 0)
                        {
                            <p>Your basket is empty.</p>
                        }
                        else
                        {
                            <BasketLines Lines="_quote!.Lines" Editable="true" OnRemove="RemoveAsync" />
                        }
                        <div class="pt-4">
                            <a href="/tours" class="text-body"><i class="fas fa-long-arrow-alt-left me-2"></i>Continue Exploring</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 basket-card__summary">
                    <div class="p-4 p-lg-5">
                        <h3 class="fw-bold mb-5 mt-2 pt-1">Summary</h3>
                        <div class="d-flex justify-content-between mb-4">
                            <h5 class="text-uppercase">Total</h5>
                            <h5>@Money.Usd(_quote?.Total ?? 0)</h5>
                        </div>
                        @if (_quote is { Bookable: false } && Basket.Count > 0)
                        {
                            <p class="small text-danger">Some tours can't be booked as they are. Change or remove them to continue.</p>
                        }
                        <hr class="my-4" />
                        @if (Basket.Count > 0)
                        {
                            <a role="button" href="/checkout" class="@($"btn btn-primary btn-block btn-lg{(_quote?.Bookable == true ? "" : " disabled")}")">Proceed To Checkout</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [CascadingParameter] private Basket Basket { get; set; } = null!;

    private BasketQuote? _quote;

    protected override async Task OnInitializedAsync()
    {
        Basket.Changed += Refresh;
        if (Basket.Loaded)
            await QuoteAsync();
    }

    private void Refresh() => _ = InvokeAsync(async () =>
    {
        await QuoteAsync();
        StateHasChanged();
    });

    private async Task QuoteAsync() =>
        _quote = Basket.Count == 0 ? new BasketQuote([])
            : await Api.Send(new QuoteBasket([.. Basket.Items.Select(i => new BasketLineRequest(i.DepartureId, i.Guests, i.Pickup))], Basket.StaffId));

    private Task RemoveAsync(DefaultIdType departureId) => Basket.RemoveAsync(departureId);

    public void Dispose() => Basket.Changed -= Refresh;
}
