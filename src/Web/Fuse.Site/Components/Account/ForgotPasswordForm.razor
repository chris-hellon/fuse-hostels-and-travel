@* "Forgot your password?" in the sign-in modal: emails a link to choose a new one. It always says it's sent, so it
   never tells anyone which emails have accounts. Also how an account made at checkout gets its first password. *@

@if (_sent)
{
    <p class="mb-4">If <strong>@_email</strong> has an account with us, a link to reset your password is on its way. It works once, for 24 hours.</p>
    <button type="button" class="btn btn-primary btn-block" @onclick="Back">Back to sign in</button>
}
else
{
    <form id="forgotPasswordForm" novalidate @onsubmit="SubmitAsync">
        <p class="mb-4">Enter your email and we'll send you a link to choose a new password.</p>
        <OutlineInput Id="ForgotPassword_Email" Label="Email" Class="mb-4" @bind-Value="_email" type="email" autocomplete="username" />
        <Validation Message="@_emailError" Style="@null" />
        @if (_error is not null)
        {
            <p class="small text-danger mb-3" role="alert">@_error</p>
        }
        <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">@(_busy ? "Sending…" : "Send reset link")</button>
        <button type="button" class="btn btn-link btn-block mt-2" @onclick="Back">Back to sign in</button>
    </form>
}

@code {
    [Inject] private IApi Api { get; set; } = null!;

    [Parameter] public EventCallback Back { get; set; }

    private string _email = "";
    private string? _error, _emailError;
    private bool _busy, _sent;

    private async Task SubmitAsync()
    {
        _emailError = string.IsNullOrWhiteSpace(_email) ? "The Email field is required." : null;
        if (_emailError is not null)
            return;

        (_busy, _error) = (true, null);
        try
        {
            await Api.Send(new Contracts.Identity.RequestPasswordReset(_email));
            _sent = true;
        }
        catch (RequestValidationException validation)
        {
            _emailError = string.Join(" ", validation.Errors.SelectMany(e => e.Value));
        }
        catch (AppException failure)
        {
            _error = failure.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
