@* A hostel's "ACCOMMODATION": room cards under a heading (legacy FullImageCardComponent). A card opens the room
   in a lightbox, with the neighbouring rooms a click away and Book Now for tonight. *@

<div class="container-fluid p-0 m-0 position-relative overflow-hidden">
    <SectionIntro Title="ACCOMMODATION">
        <div class="col-12 col-lg-6">
            <p class="m-0 p-0">@Intro</p>
        </div>
        <OvalContainer Id="hostelAccommodationOvals1" Top="-185" Left="-40" />
    </SectionIntro>
    <div class="container">
        <div class="row gx-4 gx-lg-10">
            @for (var i = 0; i < Rooms.Count; i++)
            {
                var index = i;
                var room = Rooms[index];
                <div class="col-xs-12 col-md-12 col-lg-6 mb-8 mb-lg-10 lightbox-card has-parallax-scroll" @key="room.Name">
                    <div class="card rounded-0 offcut-image-border mb-4" role="button" @onclick="() => _open = index">
                        <img loading="lazy" src="@CdnImages.Sized(room.ImagePath, 700)" alt="@($"{room.Name} image")" width="700" height="400" class="card-img-top rounded-0 object-fit-cover" />
                        <span class="tilted position-absolute">@room.Name</span>
                    </div>
                    <a class="text-primary" role="button" @onclick="() => _open = index">@room.Name.ToUpperInvariant() INFO</a>
                </div>
            }
        </div>
    </div>
</div>

@* Each room's description is in the page (hidden until its lightbox opens), as legacy's per-room lightboxes were,
   so search engines read them. *@
<div hidden>
    @foreach (var room in Rooms)
    {
        <h4>@room.Name</h4>
        @((MarkupString)(room.Description ?? ""))
    }
</div>

<FuseModal Open="_open is not null" OpenChanged="open => _open = open ? _open : null" Label="@Room?.Name"
           ModalClass="lightbox-modal" DialogClass="modal-xl modal-dialog-scrollable pt-5 pt-lg-0" ContentClass="rounded-0 bg-transparent" BodyClass="@null" CloseOutside="true">
    @if (Room is { } room && _open is { } index)
    {
        <div class="container-fluid">
            <div class="row g-0">
                <div class="col-6 text-start">
                    @if (index > 0)
                    {
                        <a class="text-white mb-3" role="button" @onclick="() => _open = index - 1"><i class="fas fa-arrow-left-long me-2"></i> PREVIOUS ROOM</a>
                    }
                </div>
                <div class="col-6 text-end">
                    @if (index + 1 < Rooms.Count)
                    {
                        <a class="text-white mb-3" role="button" @onclick="() => _open = index + 1">NEXT ROOM <i class="fas fa-arrow-right-long ms-2"></i></a>
                    }
                </div>
            </div>
            <div class="row g-0">
                <div class="col-lg-4 py-5 px-4 bg-white">
                    <div class="d-flex flex-column h-100">
                        <h4 class="tilted mb-5">@room.Name</h4>
                        @((MarkupString)(room.Description ?? ""))
                        <div class="mt-3">
                            @* target: a server route (it redirects to Cloudbeds), so the browser loads it rather than Blazor's router. *@
                            <a class="btn btn-primary align-bottom pe-5 ps-5" href="@BookTonight" target="_top">BOOK NOW</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <img class="object-fit-cover img-fluid h-100" src="@CdnImages.Sized(room.ImagePath, 1600)" alt="@($"{room.Name} image")" />
                </div>
            </div>
        </div>
    }
</FuseModal>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SiteRoom> Rooms { get; set; } = [];
    [Parameter, EditorRequired] public string Intro { get; set; } = "";
    /// <summary>The hostel's slug, for Book Now.</summary>
    [Parameter, EditorRequired] public string HostelSlug { get; set; } = "";

    private int? _open;

    private SiteRoom? Room => _open is { } index && index < Rooms.Count ? Rooms[index] : null;

    /// <summary>Legacy's room Book Now: tonight, one night.</summary>
    private string BookTonight =>
        $"/hostel-booking/{HostelSlug}?checkin={DateTime.Today:yyyy-MM-dd}&checkout={DateTime.Today.AddDays(1):yyyy-MM-dd}";
}
