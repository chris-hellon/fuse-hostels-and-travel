@inherits LayoutComponentBase
@inject IAuthClient Auth
@inject NavigationManager Navigation

@* Ported from the legacy MainLayout. *@

<MudThemeProvider Theme="Theme.AdminTheme.Fuse" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="_bookingsChanged" IsFixed="true">
<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="admin-appbar">
        <MudTooltip Text="Toggle Drawer">
            <MudIconButton Icon="@Icons.Material.Rounded.Notes" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" />
        </MudTooltip>
        <MudButton Variant="Variant.Text" Href="/admin" Class="admin-appbar__brand">
            <MudImage Src="@Branding.LogoUrl" Height="40" Class="me-2" />
            @Branding.Name
        </MudButton>
        <MudSpacer />
        <QuickActions />
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <span class="admin-appbar__rule" aria-hidden="true"></span>
            <FuseClock />
        </MudHidden>
        <MudMenu AnchorOrigin="Origin.BottomRight" LockScroll="true" TransformOrigin="Origin.TopRight">
            <ActivatorContent Context="menu">
                <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" OnClick="@(e => menu.ToggleAsync(e))" aria-label="Account menu" />
            </ActivatorContent>
            <ChildContent>
                <div class="py-2" style="min-width: 220px">
                    <PersonCard Class="mt-n2" Style="margin-bottom:0px!important" />
                    <MudMenuItem Href="/admin/account">
                        <div class="d-flex">
                            <MudIcon Class="mx-2" Icon="@Icons.Material.Filled.Person" />
                            <MudText>Account</MudText>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem Href="/admin">
                        <div class="d-flex">
                            <MudIcon Class="mx-2" Icon="@Icons.Material.Filled.Dashboard" />
                            <MudText>Dashboard</MudText>
                        </div>
                    </MudMenuItem>
                    <div class="mt-4 mx-4">
                        <MudButton Color="Color.Error" FullWidth="true" StartIcon="@Icons.Material.Filled.Logout" Variant="Variant.Filled" OnClick="SignOutAsync">
                            Logout
                        </MudButton>
                    </div>
                </div>
            </ChildContent>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Never" Class="admin-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-6 mb-6">
            @Body
            <MudScrollToTop TopOffset="400" Style="z-index:2000;">
                <MudFab StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Color="Color.Primary" />
            </MudScrollToTop>
        </MudContainer>
    </MudMainContent>
</MudLayout>
</CascadingValue>

@code {
    private bool _drawerOpen = true;
    private readonly BookingsChanged _bookingsChanged = new();

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/admin/login");
    }
}
