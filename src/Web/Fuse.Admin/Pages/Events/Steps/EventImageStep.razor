@* The event's image (legacy's Image step): picked here, uploaded with the event on Save. *@

<ImagePicker Label="Image" Hint="Optional. Shown on event cards and the event page." Src="@Preview" Pending="Draft.NewImage is not null"
             OnPick="PickImageAsync" OnRemove="RemoveImage" />

@code {
    [Parameter, EditorRequired] public EventDraft Draft { get; set; } = null!;

    private string? Preview => Draft.NewImage is { } image
        ? $"data:{image.ContentType};base64,{Convert.ToBase64String(image.Content)}"
        : Draft.ImagePath;

    private async Task PickImageAsync(InputFileChangeEventArgs e) =>
        await Snackbar.TryAsync(async () => Draft.NewImage = await e.File.ToUploadAsync());

    /// <summary>Discards a picked (unsaved) image, otherwise marks the saved one for removal on Save.</summary>
    private void RemoveImage()
    {
        if (Draft.NewImage is not null)
        {
            Draft.NewImage = null;
            return;
        }
        Draft.ImagePath = null;
        Draft.RemoveImage = true;
    }
}
