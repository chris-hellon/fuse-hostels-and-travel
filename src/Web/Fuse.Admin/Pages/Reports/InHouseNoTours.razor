@page "/admin/reports/in-house"
@attribute [RequirePermission(FuseAction.View, FuseResource.Reports)]
@using Fuse.Admin.Components.Bookings
@using Fuse.Contracts.Dashboard

@* Reports › In House, No Tours Booked: hostel guests staying now (or arriving today or tomorrow) with no tour booked
   during their stay, leaving (arriving) soonest first, so reception knows who to talk to. In house / Arriving beside
   the title; the table with search, a hostel filter, sorting and pages. From Cloudbeds. *@

<AdminPageHeader Title="In House, No Tours Booked" Description="Hostel guests with no tour booked during their stay.">
    <ViewSwitch TView="bool" Options="StayOptions" Value="_arriving" ValueChanged="SwitchAsync" />
</AdminPageHeader>

@if (_hostels is { Unreachable.Count: > 0 } hostels)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        Cloudbeds couldn't be reached for @string.Join(", ", hostels.Unreachable) just now, so their guests are missing. Reload in a couple of minutes.
    </MudAlert>
}
<EntityTable @ref="_table" T="GuestWithoutToursRow" Fields="Fields" Load="LoadAsync" EntityNamePlural="Guests" ShowMenu="_ => false">
    <AdvancedSearchContent>
        <MudSelect T="string" Label="Hostel" Value="_hostel" ValueChanged="FilterAsync" Clearable="true" Variant="Variant.Outlined" Class="mt-1">
            @foreach (var hostel in _hostels?.Hostels ?? [])
            {
                <MudSelectItem T="string" Value="hostel">@hostel</MudSelectItem>
            }
        </MudSelect>
    </AdvancedSearchContent>
    <RowButtons>
        @if (context.ReservationUrl is { } url)
        {
            <RowIconButton Icon="@Icons.Material.Filled.OpenInNew" Label="Open in Cloudbeds" Href="@url" Target="_blank" />
        }
    </RowButtons>
</EntityTable>

@code {
    private static readonly IReadOnlyList<ViewSwitch<bool>.Option> StayOptions =
    [
        new(false, Icons.Material.Filled.Hotel, "In House"),
        new(true, Icons.Material.Filled.FlightLand, "Arriving"),
    ];

    private static readonly IReadOnlyList<EntityField<GuestWithoutToursRow>> Fields =
    [
        new(g => g.Name, "Guest", nameof(GuestWithoutToursRow.Name), g => @<span>
            @if (g.GuestId is not null)
            {
                <GuestLink GuestId="@g.GuestId" Name="@g.Name" />
            }
            else
            {
                <span title="Not imported from Cloudbeds yet">@g.Name</span>
            }
        </span>),
        new(g => g.Hostel, "Hostel", nameof(GuestWithoutToursRow.Hostel)),
        new(g => g.CheckIn.ToString("ddd dd/MM"), "Check In", nameof(GuestWithoutToursRow.CheckIn)) { Width = "1%" },
        new(g => g.CheckOut.ToString("ddd dd/MM"), "Check Out", nameof(GuestWithoutToursRow.CheckOut)) { Width = "1%" },
    ];

    private EntityTable<GuestWithoutToursRow>? _table;
    private GuestsWithoutToursHostels? _hostels;
    private bool _arriving;
    private string? _hostel;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _hostels = await Api.Send(new GetGuestsWithoutToursHostels());
        }
        catch (AppException)
        {
            // The table says what went wrong.
        }
    }

    private Task<PagedResult<GuestWithoutToursRow>> LoadAsync(GridRequest request, CancellationToken cancellationToken) =>
        Api.Send(request.Apply(new SearchGuestsWithoutTours { Arriving = _arriving, Hostel = _hostel }), cancellationToken).AsTask();

    private async Task SwitchAsync(bool arriving)
    {
        _arriving = arriving;
        await _table!.ReloadAsync();
    }

    private async Task FilterAsync(string? hostel)
    {
        _hostel = hostel;
        await _table!.ReloadAsync();
    }
}
