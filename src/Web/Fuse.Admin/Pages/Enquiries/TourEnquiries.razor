@page "/admin/enquiries/tours-enquiries"
@attribute [RequirePermission(FuseAction.View, FuseResource.Enquiries)]
@using Fuse.Contracts.Enquiries
@inject FileSaver Files

@* Legacy Tour Enquiries: Enquire Now on tours that can't be booked online, newest first. View one to read and reply;
   mark it replied. *@

<AdminPageHeader Title="Tour Enquiries" Description="Enquire Now requests for tours, sent from the website." />

<EntityTable @ref="_table" T="TourEnquirySummary" Fields="Fields" Load="LoadAsync" EntityNamePlural="Tour Enquiries" Resource="@FuseResource.Enquiries"
             OnExport="ExportAsync" OnDelete="DeleteAsync">
    <AdvancedSearchContent>
        <EnquiryStatusFilter Value="_status" ValueChanged="FilterAsync" />
    </AdvancedSearchContent>
    <RowButtons>
        <RowIconButton Icon="@Icons.Material.Outlined.Visibility" Label="View" OnClick="() => ViewAsync(context)" />
    </RowButtons>
</EntityTable>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly IReadOnlyList<EntityField<TourEnquirySummary>> Fields =
    [
        new(e => e.Submitted.ToString("dd/MM/yyyy HH:mm"), "Sent", nameof(TourEnquirySummary.Submitted)) { Width = "1%" },
        new(e => e.TourName, "Tour", nameof(TourEnquirySummary.TourName)),
        new(e => e.RequestedDate.ToString("dd/MM/yyyy"), "Requested Date", nameof(TourEnquirySummary.RequestedDate)),
        new(e => e.NumberOfPeople, "People", nameof(TourEnquirySummary.NumberOfPeople)),
        new(e => e.Name, "Name", nameof(TourEnquirySummary.Name)),
        new(e => e.Email, "Email", nameof(TourEnquirySummary.Email)),
        new(e => EnquiryPages.Label(e.Status), "Status", Template: e => @<EnquiryStatusChip Status="e.Status" />) { Width = "1%" },
    ];

    private EntityTable<TourEnquirySummary>? _table;
    private string? _keyword;
    private EnquiryStatus? _status;

    private async Task<PagedResult<TourEnquirySummary>> LoadAsync(GridRequest request, CancellationToken cancellationToken)
    {
        _keyword = request.Keyword;
        return await Api.Send(request.Apply(new SearchTourEnquiries { Status = _status }), cancellationToken);
    }

    private async Task FilterAsync(EnquiryStatus? status)
    {
        _status = status;
        await _table!.ReloadAsync();
    }

    private async Task ViewAsync(TourEnquirySummary row)
    {
        TourEnquiryDetails? details = null;
        if (!await Snackbar.TryAsync(async () => details = await Api.Send(new GetTourEnquiry(row.Id))))
            return;
        var e = details!.Summary;
        var dialog = await Dialogs.ShowAsync<EnquiryDialog>(null, new DialogParameters<EnquiryDialog>
        {
            { d => d.Title, $"{e.TourName}: enquiry from {e.Name}" }, { d => d.Submitted, e.Submitted }, { d => d.Email, e.Email },
            { d => d.Fields,
                [("Tour", e.TourName), ("Requested Date", e.RequestedDate.ToString("dddd d MMMM yyyy")), ("Number of People", e.NumberOfPeople.ToString()),
                 ("Name", e.Name), ("Email", e.Email), ("Contact Number", e.ContactNumber), ("Special Requests", details.AdditionalInformation)] },
            { d => d.Kind, EnquiryKind.Tour }, { d => d.Id, e.Id }, { d => d.Status, e.Status },
            { d => d.CanUpdate, EnquiryPages.CanUpdate(AuthState is null ? null : (await AuthState).User) },
        }, EnquiryPages.ConversationOptions);
        // Always: the row's status can change just by opening it (replies read from the inbox).
        await dialog.Result;
        await _table!.ReloadAsync();
    }

    private async Task ExportAsync() =>
        await Snackbar.TryAsync(async () => await Files.SaveAsync(await Api.Send(new ExportEnquiries(EnquiryKind.Tour, _keyword, null, _status))));

    private async Task DeleteAsync(TourEnquirySummary e)
    {
        if (!await Dialogs.ConfirmAsync("Delete this enquiry?", $"The enquiry from {e.Name} about {e.TourName} will be deleted.", "Delete enquiry", "Keep enquiry"))
            return;
        if (await Snackbar.TryAsync(async () => await Api.Send(new DeleteEnquiry(EnquiryKind.Tour, e.Id)), "Enquiry deleted."))
            await _table!.ReloadAsync();
    }
}
