@using Fuse.Contracts.Locations

@* Legacy location wizard: everything (including a newly picked image) saves together on Save. *@

<ModalWizard TModel="LocationModel" Model="_model!" Loading="_model is null" OnSave="SaveAsync">
    <TitleContent>
        <MudIcon Icon="@(IsCreate ? Icons.Material.Filled.Add : Icons.Material.Filled.Update)" Class="mr-3 mb-n1" />
        @(IsCreate ? "Create Location" : "Edit Location")
    </TitleContent>
    <ChildContent>
        @if (_model is not null)
        {
            <WizardStep TModel="LocationModel" Title="Content" Validator="Rules" ValidationTarget="Command" ValidationProperties="@(["Details.Name"])" OnLeaveAsync="_ => Task.FromResult(_content?.EnsureRequired() ?? true)">
                <ContentSections @ref="_content" Sections="_sections" />
            </WizardStep>
            <WizardStep TModel="LocationModel" Title="Image">
                <ImagePicker Label="Banner image" Hint="Shown at the top of the location page." Src="@Preview" Pending="_model.NewImage is not null"
                             OnPick="PickImageAsync" OnRemove="RemoveImage" />
            </WizardStep>
        }
    </ChildContent>
</ModalWizard>

@code {
    public static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };

    [Parameter] public DefaultIdType? LocationId { get; set; }

    private bool IsCreate => LocationId is null;
    private LocationModel? _model;
    /// <summary>The save's rules, checked step by step (each step lists the ones it edits).</summary>
    private static readonly SaveLocationValidator Rules = new();
    private object Command() => new SaveLocation(LocationId, _model!.Details, _model.NewImage, _model.RemoveImage);
    private IReadOnlyList<ContentSection> _sections = [];

    private ContentSections? _content;

    private void BuildSections(LocationInput details) => _sections =
    [
        ContentSection.Fields("Details", "Name and map", DetailsForm(details), () => !string.IsNullOrWhiteSpace(details.Name), required: true),
        new("Short description", "A sentence or two about the location", () => details.ShortDescription, v => details.ShortDescription = v),
        new("Description", "The main text on the location page", () => details.Description, v => details.Description = v),
        new("Directions", "How to get there", () => details.Directions, v => details.Directions = v),
    ];

    private RenderFragment DetailsForm(LocationInput details) =>
        @<MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField Label="Name" @bind-Value="details.Name" Required="true" RequiredError="Name is required" MaxLength="1024"
                              Placeholder="Enter a location name" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Google Maps Key" @bind-Value="details.GoogleMapsKey" Variant="Variant.Outlined"
                              HelperText="An address for the location, to show it on a Google map" />
            </MudItem>
        </MudGrid>;

    private string? Preview => _model?.NewImage is { } image
        ? $"data:{image.ContentType};base64,{Convert.ToBase64String(image.Content)}"
        : _model?.ImagePath;

    protected override async Task OnInitializedAsync()
    {
        if (IsCreate)
        {
            _model = new LocationModel();
            BuildSections(_model.Details);
            return;
        }
        await Snackbar.TryAsync(async () =>
        {
            var location = await Api.Send(new GetLocation(LocationId!.Value));
            _model = new LocationModel { Details = location.Details, ImagePath = location.ImagePath };
            BuildSections(_model.Details);
        });
    }

    private async Task PickImageAsync(InputFileChangeEventArgs e) =>
        await Snackbar.TryAsync(async () => _model!.NewImage = await e.File.ToUploadAsync());

    /// <summary>Discards a picked (unsaved) image, otherwise marks the saved one for removal on Save.</summary>
    private void RemoveImage()
    {
        if (_model!.NewImage is not null)
        {
            _model.NewImage = null;
            return;
        }
        _model.ImagePath = null;
        _model.RemoveImage = true;
    }

    private async Task<bool> SaveAsync(LocationModel model) =>
        await Snackbar.TryAsync(async () => await Api.Send(new SaveLocation(LocationId, model.Details, model.NewImage, model.RemoveImage)),
            IsCreate ? "Location Created." : "Location Updated.");

    public sealed class LocationModel
    {
        public LocationInput Details { get; set; } = new();
        public string? ImagePath { get; set; }
        public FileUpload? NewImage { get; set; }
        public bool RemoveImage { get; set; }
    }
}
