@using Heron.MudCalendar

<StepToolbar Subtitle="@Summary">
    <Views>
        <ViewSwitch TView="bool" Options="ViewOptions" @bind-Value="_calendar" />
    </Views>
    <SecondaryActions>
        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DeleteSweep"
                   Disabled="@(Draft.Dates.Count == 0)" OnClick="DeleteRangeAsync">Delete date range</MudButton>
    </SecondaryActions>
    <ChildContent>
        <MudTooltip Text="@(HasPrices ? "" : "Add a price first")">
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OverrideStyles="false">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DateRange"
                           Disabled="!HasPrices" OnClick="AddRangeAsync">Add date range</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Event"
                           Disabled="!HasPrices" OnClick="() => EditAsync(null)">Add date</MudButton>
            </MudButtonGroup>
        </MudTooltip>
    </ChildContent>
</StepToolbar>
<SavedWithParentNote Parent="tour" />

@if (_calendar)
{
    @* All dates are in memory, so the calendar only filters; it never reloads (no render loop). *@
    <MudCalendar T="CalendarItem" Items="_calendarItems" MonthCellMinHeight="60" Color="Color.Dark" Class="mt-3">
        <CellTemplate>
            <MudTooltip Inline="false" RootStyle="width:100%; height:100%;">
                <ChildContent>
                    <MudChip T="string" Color="Color.Dark" Label="true" Class="mud-cal-cell-template-chip" Style="margin-bottom:1px;">@context.Start.ToString("HH:mm")</MudChip>
                </ChildContent>
                <TooltipContent>
                    <MudText Typo="Typo.body2">@context.Start.ToString("ddd d MMM HH:mm") – @context.End?.ToString("HH:mm")</MudText>
                    <MudText Typo="Typo.caption">@context.Text</MudText>
                </TooltipContent>
            </MudTooltip>
        </CellTemplate>
    </MudCalendar>
}
else
{
    @if (_selected.Count > 0)
    {
        <div class="selection-bar">
            <MudText Typo="Typo.body2"><b>@_selected.Count</b> selected</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteSelectedAsync">Delete selected</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _selected.Clear()">Clear selection</MudButton>
        </div>
    }
    <MudTable T="DateDraft" Items="Draft.Dates" @bind-SelectedItems="_selected" MultiSelection="true" SelectOnRowClick="false" Context="date"
              Hover="true" Dense="true" Elevation="0" Class="admin-subtable" Breakpoint="Breakpoint.Sm" RowsPerPage="10" RowClassFunc="RowClass">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Time</MudTh>
            <MudTh>Price</MudTh>
            <MudTh>Spaces</MudTh>
            <MudTh></MudTh>
            <MudTh Style="width: 96px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@date.StartDate.ToString("ddd d MMM yyyy")</MudTd>
            <MudTd DataLabel="Time">
                @date.StartDate.ToString("HH:mm") – @Draft.EndFor(date).ToString("HH:mm")
                @if (Draft.EndFor(date).Date != date.StartDate.Date)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">ends @Draft.EndFor(date).ToString("ddd d MMM")</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Price">
                @if (Draft.FindPrice(date.PriceKey) is { } price)
                {
                    <span class="admin-amount">$@((date.PriceOverride ?? price.Details.Price).ToString("N2"))</span>
                    @if (date.PriceOverride.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">Override</MudChip>
                    }
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@price.Details.Title</MudText>
                }
                else
                {
                    <span class="mud-text-secondary">No price</span>
                }
            </MudTd>
            <MudTd DataLabel="Spaces">@(date.AvailableSpaces >= UnlimitedSpaces ? "Unlimited" : date.AvailableSpaces.ToString())</MudTd>
            <MudTd DataLabel="Status">
                @if (date.IsNew)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">New</MudChip>
                }
                else if (date.IsChanged)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">Edited</MudChip>
                }
                @if (date.Booked)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">Booked</MudChip>
                }
            </MudTd>
            <MudTd Class="admin-row-actions">
                <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => EditAsync(date)" aria-label="Edit" /></MudTooltip>
                <MudTooltip Text="@(date.Booked ? "Has bookings, can't be deleted" : "Delete")">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" Disabled="date.Booked" OnClick="() => DeleteAsync(date)" aria-label="Delete" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="admin-empty">
                <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Class="mud-text-secondary" />
                <MudText Typo="Typo.body2">@(HasPrices ? "No upcoming dates. Use Add date range or Add date." : "Add a price on the Pricing step, then add dates here.")</MudText>
            </div>
        </NoRecordsContent>
        <PagerContent>
            @if (Draft.Dates.Count > 10)
            {
                <MudTablePager RowsPerPageString="Rows per page" />
            }
        </PagerContent>
    </MudTable>
}

@code {
    /// <summary>Tours without a max capacity store this many spaces per departure.</summary>
    private const int UnlimitedSpaces = 99999;

    private static readonly IReadOnlyList<ViewSwitch<bool>.Option> ViewOptions =
    [
        new(false, Icons.Material.Outlined.TableRows, "List"),
        new(true, Icons.Material.Outlined.CalendarMonth, "Calendar"),
    ];

    [Parameter, EditorRequired] public TourDraft Draft { get; set; } = null!;

    private bool _calendar;
    private HashSet<DateDraft> _selected = [];
    private List<CalendarItem> _calendarItems = [];

    private bool HasPrices => Draft.Prices.Count > 0;

    private string Summary
    {
        get
        {
            var parts = new List<string> { $"{Draft.Dates.Count:N0} upcoming" };
            if (Draft.Dates.Count(d => d.IsNew) is var added and > 0)
                parts.Add($"{added:N0} new");
            if (Draft.PendingDeletes > 0)
                parts.Add($"{Draft.PendingDeletes:N0} to delete");
            return string.Join(" · ", parts);
        }
    }

    protected override void OnParametersSet() => RefreshCalendar();

    private void RefreshCalendar() =>
        _calendarItems = [.. Draft.Dates.Select(d => new CalendarItem
        {
            Start = d.StartDate,
            End = Draft.EndFor(d),
            Text = Draft.FindPrice(d.PriceKey) is { } p ? $"{p.Details.Title} ${(d.PriceOverride ?? p.Details.Price):N2}" : "No price",
        })];

    private string RowClass(DateDraft date, int _) => date.IsNew || date.IsChanged ? "is-pending" : "";

    private static DialogOptions Small => new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

    private async Task AddRangeAsync()
    {
        var dialog = await Dialogs.ShowAsync<TourDateRangeDialog>(null, new DialogParameters<TourDateRangeDialog> { { d => d.Draft, Draft } }, Small);
        if (!(await dialog.Result)!.Canceled)
            RefreshCalendar();
    }

    private async Task DeleteRangeAsync()
    {
        var dialog = await Dialogs.ShowAsync<DeleteTourDatesDialog>(null, new DialogParameters<DeleteTourDatesDialog> { { d => d.Draft, Draft } }, Small);
        if (!(await dialog.Result)!.Canceled)
        {
            _selected.RemoveWhere(d => !Draft.Dates.Contains(d));
            RefreshCalendar();
        }
    }

    private async Task EditAsync(DateDraft? date)
    {
        var dialog = await Dialogs.ShowAsync<TourDateDialog>(null, new DialogParameters<TourDateDialog> { { d => d.Draft, Draft }, { d => d.Date, date } }, Small);
        if (!(await dialog.Result)!.Canceled)
            RefreshCalendar();
    }

    private async Task DeleteAsync(DateDraft date)
    {
        if (!await Dialogs.ConfirmAsync("Delete this date?",
                $"{date.StartDate:dddd d MMMM yyyy} at {date.StartDate:HH:mm} will be removed when you save the tour.",
                "Delete date", "Keep date"))
            return;
        Draft.DeleteDates([date]);
        _selected.Remove(date);
        RefreshCalendar();
    }

    private async Task DeleteSelectedAsync()
    {
        var count = _selected.Count;
        if (!await Dialogs.ConfirmAsync($"Delete {count:N0} date{(count == 1 ? "" : "s")}?",
                $"The {count:N0} selected date{(count == 1 ? "" : "s")} will be removed when you save the tour.",
                $"Delete date{(count == 1 ? "" : "s")}", $"Keep date{(count == 1 ? "" : "s")}",
                detail: "Dates with bookings are kept."))
            return;
        var kept = Draft.DeleteDates(_selected);
        if (kept > 0)
            Snackbar.Add($"{kept} date{(kept == 1 ? " has" : "s have")} bookings and {(kept == 1 ? "was" : "were")} kept.", Severity.Warning);
        _selected = [];
        RefreshCalendar();
    }
}
