@using Fuse.Shared.Text

@* Create / edit a travel guide. Every step edits a TravelGuideDraft; Save sends it all in one command. *@

<ModalWizard TModel="TravelGuideDraft" Model="_draft!" Loading="_draft is null" OnSave="SaveAsync" OnCancel="CancelAsync">
    <TitleContent>
        <MudIcon Icon="@(IsCreate ? Icons.Material.Filled.Add : Icons.Material.Filled.Update)" Class="mr-3 mb-n1" />
        @(IsCreate ? "Create Travel Guide" : "Edit Travel Guide")
    </TitleContent>
    <ChildContent>
        @if (_draft is not null)
        {
            <WizardStep TModel="TravelGuideDraft" Title="Content" Validator="Rules" ValidationTarget="Changes" ValidationProperties="@(["Details.Title", "Details.SubTitle", "Details.ShortDescription", "Details.Description"])" OnLeaveAsync="_ => Task.FromResult(_content?.EnsureRequired() ?? true)">
                <ContentSections @ref="_content" Sections="_sections" UploadImage="UploadAsync" />
            </WizardStep>
            <WizardStep TModel="TravelGuideDraft" Title="SEO" Validator="Rules" ValidationTarget="Changes" ValidationProperties="@(["Details.UrlSlug"])">
                <SeoFieldsEditor Seo="_draft.Details" SlugHint="@SlugHint" />
            </WizardStep>
            <WizardStep TModel="TravelGuideDraft" Title="Images" OnLeaveAsync="_ => Task.FromResult(HasBanner())">
                <TravelGuideImagesStep Draft="_draft" />
            </WizardStep>
        }
    </ChildContent>
</ModalWizard>

@code {
    public static readonly DialogOptions Options = new() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };

    [Parameter] public DefaultIdType? TravelGuideId { get; set; }

    private bool IsCreate => TravelGuideId is null;
    private TravelGuideDraft? _draft;
    /// <summary>The save's rules, checked step by step (each step lists the ones it edits).</summary>
    private static readonly TravelGuideChangesValidator Rules = new();
    private object Changes() => _draft!.ToChanges();
    private IReadOnlyList<ContentSection> _sections = [];
    private ContentSections? _content;

    private string SlugHint => string.IsNullOrWhiteSpace(_draft?.Details.UrlSlug)
        ? $"The guide's web address. Leave empty to use the title: {Slugs.From(_draft?.Details.Title)}"
        : "The guide's web address, e.g. best-bars-in-hoi-an";

    protected override Task OnInitializedAsync() => Snackbar.TryAsync(async () =>
    {
        var draft = IsCreate ? TravelGuideDraft.New() : TravelGuideDraft.From(await Api.Send(new GetTravelGuideEditor(TravelGuideId!.Value)));
        var details = draft.Details;
        _sections =
        [
            ContentSection.Fields("Details", "Title and sub title", DetailsForm(details),
                () => !string.IsNullOrWhiteSpace(details.Title) && !string.IsNullOrWhiteSpace(details.SubTitle), required: true),
            new("Short description", "On the guide's card on the Travel Guides page", () => details.ShortDescription, v => details.ShortDescription = v ?? "", Required: true),
            new("Full description", "The guide itself", () => details.Description, v => details.Description = v ?? "", Required: true),
        ];
        _draft = draft;
    });

    /// <summary>Pictures in the text are stored straight away and linked from the HTML (as legacy).</summary>
    private async Task<string> UploadAsync(FileUpload file) => await Api.Send(new UploadTravelGuideImage(file));

    private bool HasBanner()
    {
        if (_draft!.Banner is not null)
            return true;
        Snackbar.Add("Choose a banner image.", Severity.Warning);
        return false;
    }

    private RenderFragment DetailsForm(TravelGuideInput details) =>
        @<MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField Label="Title" @bind-Value="details.Title" Required="true" RequiredError="Title is required" MaxLength="1024" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Sub title" @bind-Value="details.SubTitle" Required="true" RequiredError="Sub title is required" MaxLength="1024"
                              Variant="Variant.Outlined" Lines="2" AutoGrow="true" />
            </MudItem>
        </MudGrid>;

    private async Task<bool> SaveAsync(TravelGuideDraft draft) =>
        await Snackbar.TryAsync(async () =>
        {
            if (draft.IsNew)
                await Api.Send(new CreateTravelGuide(draft.ToChanges()));
            else
                await Api.Send(new UpdateTravelGuide(draft.Id!.Value, draft.ToChanges()));
        }, IsCreate ? "Travel guide created." : "Travel guide saved.");

    private async Task<bool> CancelAsync() =>
        _draft is not { HasChanges: true }
        || await Dialogs.ConfirmAsync("Discard your changes?", "You've changed this travel guide but haven't saved it. If you close now, those changes are lost.",
            "Discard changes", "Keep editing");
}
