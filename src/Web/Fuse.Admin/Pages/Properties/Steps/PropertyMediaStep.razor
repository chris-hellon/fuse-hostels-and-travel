@using Fuse.Contracts.Properties

@* Picked files upload straight away (to keep Save small) but are only attached on Save. *@

<MudGrid Spacing="4">
    <MudItem xs="12" md="6">
        <ImagePicker Label="Banner image *" Hint="Shown at the top of the property page. Required." Src="@Draft.Banner" Busy="_bannerBusy"
                     Pending="@(Draft.Banner is not null && Draft.Banner != _originalBanner)" OnPick="PickBannerAsync" OnRemove="() => Draft.Banner = null" />
    </MudItem>
    <MudItem xs="12" md="6">
        <ImagePicker Label="Video" Hint="Optional. Plays on the property page." Src="@Draft.Video" Video="true" Busy="_videoBusy"
                     Pending="@(Draft.Video is not null && Draft.Video != _originalVideo)" OnPick="PickVideoAsync" OnRemove="() => Draft.Video = null" />
    </MudItem>
    <MudItem xs="12">
        <div class="image-picker__label">
            <MudText Typo="Typo.subtitle2">Slideshow</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Shown in this order on the property page. Use the arrows to reorder.</MudText>
        </div>
        <ImageGallery TItem="PropertySlide" Items="Draft.Gallery" Url="s => s.DisplayUrl" Badge="@(s => s.NewUrl is null ? null : "Unsaved")" Busy="_galleryBusy"
                      OnAdd="AddSlidesAsync" OnRemove="s => Draft.Gallery.Remove(s)" OnMove="Move" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public PropertyDraft Draft { get; set; } = null!;

    private string? _originalBanner;
    private string? _originalVideo;
    private bool _bannerBusy, _videoBusy, _galleryBusy;

    protected override void OnInitialized() => (_originalBanner, _originalVideo) = (Draft.Banner, Draft.Video);

    private async Task PickBannerAsync(InputFileChangeEventArgs e)
    {
        _bannerBusy = true;
        await Snackbar.TryAsync(async () => Draft.Banner = await Api.Send(new UploadPropertyMedia(await e.File.ToUploadAsync(), IsVideo: false)));
        _bannerBusy = false;
    }

    private async Task PickVideoAsync(InputFileChangeEventArgs e)
    {
        _videoBusy = true;
        await Snackbar.TryAsync(async () => Draft.Video = await Api.Send(new UploadPropertyMedia(await e.File.ToUploadAsync(), IsVideo: true)));
        _videoBusy = false;
    }

    private async Task AddSlidesAsync(InputFileChangeEventArgs e)
    {
        _galleryBusy = true;
        foreach (var file in e.GetMultipleFiles(20))
        {
            // One at a time: a bad file doesn't lose the good ones.
            await Snackbar.TryAsync(async () =>
            {
                var url = await Api.Send(new UploadPropertyMedia(await file.ToUploadAsync(), IsVideo: false));
                Draft.Gallery.Add(new PropertySlide(null, url, url));
            });
            StateHasChanged();
        }
        _galleryBusy = false;
    }

    private void Move((int Index, int By) move) =>
        (Draft.Gallery[move.Index], Draft.Gallery[move.Index + move.By]) = (Draft.Gallery[move.Index + move.By], Draft.Gallery[move.Index]);

    /// <summary>The banner is required (checked before Save, as the server also does).</summary>
    public bool Validate()
    {
        if (Draft.Banner is not null)
            return true;
        Snackbar.Add("Choose a banner image.", Severity.Warning);
        return false;
    }
}
