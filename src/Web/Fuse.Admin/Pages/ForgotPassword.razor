@page "/admin/forgot-password"
@page "/admin/account/forgot-password"
@layout AdminBlankLayout
@attribute [AllowAnonymous]

@* Legacy Forgot Password: a reset link is emailed to staff (it always says so, whether or not the email has an
   account, so nobody can find out which do). *@

<PageTitle>Forgot your password?</PageTitle>

<AuthCard Title="Forgot Password?" Intro="@(_sent ? null : "Enter your email and we'll send you a link to reset your password.")">
    @if (_sent)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            If <strong>@_email</strong> has a Fuse account, a link to reset your password is on its way. It works once, for 24 hours.
        </MudAlert>
        <MudButton Href="/admin/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Style="width: 100%;">Back to Sign In</MudButton>
    }
    else
    {
        <EditForm Model="this" OnValidSubmit="SubmitAsync" FormName="admin-forgot-password">
            <MudGrid Spacing="3">
                @if (_error is not null)
                {
                    <MudItem xs="12"><MudAlert Severity="Severity.Error">@_error</MudAlert></MudItem>
                }
                <MudItem xs="12">
                    <MudTextField @bind-Value="_email" Placeholder="Email" Variant="Variant.Outlined" InputType="InputType.Email" Required="true" autocomplete="username" />
                </MudItem>
                <MudItem xs="12" Class="d-flex justify-space-between align-center flex-wrap gap-2">
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/admin/login">Back to Sign In</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Disabled="@(_busy || !RendererInfo.IsInteractive)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LockReset">
                        @(!RendererInfo.IsInteractive ? "Loading…" : _busy ? "Sending…" : "Send Reset Link")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    }
</AuthCard>

@code {
    private string _email = "";
    private string? _error;
    private bool _busy, _sent;

    private async Task SubmitAsync()
    {
        (_busy, _error) = (true, null);
        try
        {
            await Api.Send(new RequestPasswordReset(_email, Staff: true));
            _sent = true;
        }
        catch (RequestValidationException validation)
        {
            _error = string.Join(" ", validation.Errors.SelectMany(e => e.Value));
        }
        catch (AppException failure)
        {
            _error = failure.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
