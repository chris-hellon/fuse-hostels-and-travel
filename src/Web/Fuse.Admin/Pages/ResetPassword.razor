@page "/admin/reset-password"
@layout AdminBlankLayout
@attribute [AllowAnonymous]

@* Legacy Reset Password: the emailed link's page, to choose a new password. *@

<PageTitle>Reset password</PageTitle>

<AuthCard Title="Reset Password" Intro="@(_done ? null : "Choose a new password for your account.")">
    @if (_done)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Your password has been changed. Sign in with your new password.</MudAlert>
        <MudButton Href="/admin/login" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" Style="width: 100%;">Sign In</MudButton>
    }
    else if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">This link is incomplete. Open it straight from the email, or ask for a new one.</MudAlert>
        <MudButton Href="/admin/forgot-password" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LockReset" Style="width: 100%;">Forgot Password?</MudButton>
    }
    else
    {
        <EditForm Model="this" OnValidSubmit="SubmitAsync" FormName="admin-reset-password">
            <MudGrid Spacing="3">
                @if (_error is not null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error">
                            @_error
                            @if (_expired)
                            {
                                <MudLink Href="/admin/forgot-password" Class="ml-1">Ask for a new link.</MudLink>
                            }
                        </MudAlert>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField @bind-Value="_password" Placeholder="New password" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" autocomplete="new-password" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_confirm" Placeholder="Confirm new password" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" autocomplete="new-password" />
                </MudItem>
                <MudItem xs="12" Class="d-flex justify-center">
                    <MudButton ButtonType="ButtonType.Submit" Disabled="@(_busy || !RendererInfo.IsInteractive)" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.LockReset" Style="width: 100%;">
                        @(!RendererInfo.IsInteractive ? "Loading…" : _busy ? "Saving…" : "Reset Password")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    }
</AuthCard>

@code {
    [SupplyParameterFromQuery(Name = "user")] private string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] private string? Token { get; set; }

    private string _password = "", _confirm = "";
    private string? _error;
    private bool _busy, _done, _expired;

    private async Task SubmitAsync()
    {
        (_busy, _error, _expired) = (true, null, false);
        try
        {
            await Api.Send(new Fuse.Contracts.Identity.ResetPassword(UserId!, Token!, _password, _confirm));
            _done = true;
        }
        catch (RequestValidationException validation)
        {
            _error = string.Join(" ", validation.Errors.SelectMany(e => e.Value));
        }
        catch (BusinessRuleException expired)
        {
            (_error, _expired) = (expired.Message, true);
        }
        catch (AppException failure)
        {
            _error = failure.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
