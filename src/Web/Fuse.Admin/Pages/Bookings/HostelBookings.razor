@page "/admin/bookings/hostel-bookings"
@attribute [RequirePermission(FuseAction.View, FuseResource.TourBookings)]
@using Fuse.Admin.Components.Bookings

@* Bookings › Hostel Bookings: each hostel's reservations from Cloudbeds (in house, arriving this week, or any status by
   check-in dates, a week either side of today to start), each guest matched to our customer, with their tour bookings
   in the row's details. View only: nothing is booked or changed here. In House / Arriving / By Date (with its dates)
   beside the title; search and hostel filters, sorting and pages as Tour Bookings. *@

<AdminPageHeader Title="Hostel Bookings" Description="Hostel reservations from Cloudbeds, with each guest's tour bookings.">
    <ViewSwitch TView="HostelBookingsView" Options="ViewOptions" Value="_view" ValueChanged="SwitchAsync" />
</AdminPageHeader>

@if (_view == HostelBookingsView.All)
{
    <div class="hostel-bookings__range">
        <MudDateRangePicker Label="Checking in between" DateRange="_checkIn" DateRangeChanged="SetCheckInAsync" AutoClose="true" PickerVariant="PickerVariant.Inline"
                            DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_loading" />
    </div>
}
@if (_loading)
{
    <div class="hostel-bookings__loading" role="status">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" />
        <span>Fetching reservations from Cloudbeds…</span>
    </div>
}
else if (_hostels is { Unreachable.Count: > 0 } hostels)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        Cloudbeds couldn't be reached for @string.Join(", ", hostels.Unreachable) just now, so their reservations are missing. Reload in a couple of minutes.
    </MudAlert>
}
<EntityTable @ref="_table" T="HostelBookingRow" Fields="Fields" Load="LoadAsync" EntityNamePlural="Hostel Bookings" ShowMenu="_ => false">
    <AdvancedSearchContent>
        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="12" md="6">
                <MudSelect T="string" Label="Filter by Hostel" Value="_hostel" ValueChanged="SetHostelAsync" Clearable="true" AnchorOrigin="Origin.BottomLeft">
                    @foreach (var hostel in _hostels?.Hostels ?? [])
                    {
                        <MudSelectItem T="string" Value="hostel">@hostel</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </AdvancedSearchContent>
    <RowButtons>
        <DetailsToggle Open="@_expanded.Contains(Key(context))" OnToggle="() => ToggleDetails(context)" />
    </RowButtons>
    <ChildRowContent>
        @if (_expanded.Contains(Key(context)))
        {
            <HostelBookingDetailsRow @key="Key(context)" Row="context" Columns="_table!.ColumnCount" />
        }
    </ChildRowContent>
</EntityTable>

@code {
    private static readonly IReadOnlyList<ViewSwitch<HostelBookingsView>.Option> ViewOptions =
    [
        new(HostelBookingsView.InHouse, Icons.Material.Filled.Hotel, "In House"),
        new(HostelBookingsView.Arriving, Icons.Material.Filled.FlightLand, "Arriving"),
        new(HostelBookingsView.All, Icons.Material.Filled.DateRange, "By Date"),
    ];

    private static readonly IReadOnlyList<EntityField<HostelBookingRow>> Fields =
    [
        new(r => r.ReservationId, "Reservation", nameof(HostelBookingRow.ReservationId)) { Width = "1%" },
        new(r => r.GuestName, "Guest", nameof(HostelBookingRow.GuestName), r => @<span>
            @if (r.GuestId is not null)
            {
                <GuestLink GuestId="@r.GuestId" Name="@r.GuestName" />
            }
            else
            {
                <span title="Not imported from Cloudbeds yet">@r.GuestName</span>
            }
        </span>),
        new(r => r.Hostel, "Hostel", nameof(HostelBookingRow.Hostel)),
        new(r => r.CheckIn.ToString("ddd dd/MM"), "Check In", nameof(HostelBookingRow.CheckIn)) { Width = "1%" },
        new(r => r.CheckOut.ToString("ddd dd/MM"), "Check Out", nameof(HostelBookingRow.CheckOut)) { Width = "1%" },
        new(r => r.Nights, "Nights", nameof(HostelBookingRow.Nights)) { Width = "1%" },
        new(r => r.Tours, "Tours", nameof(HostelBookingRow.Tours)) { Width = "1%" },
        new(r => r.Balance, "Balance", nameof(HostelBookingRow.Balance), r => @<span>@(r.Balance > 0 ? $"$ {r.Balance:N2}" : "-")</span>) { Width = "1%" },
        new(r => r.Status, "Status", nameof(HostelBookingRow.Status), r => @<span class="@($"status-pill status-pill--{Tone(r.Status)}")">@r.Status</span>) { Width = "1%" },
    ];

    private EntityTable<HostelBookingRow>? _table;
    private HostelBookingHostels? _hostels;
    private HostelBookingsView _view = HostelBookingsView.InHouse;
    private string? _hostel;
    /// <summary>All: checking in a week either side of today until other dates are picked.</summary>
    private DateRange? _checkIn = new(DateTime.Today.AddDays(-7), DateTime.Today.AddDays(7));
    private readonly HashSet<string> _expanded = [];

    // After the table's first load (it asks Cloudbeds; this then reads what it fetched).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await LoadHostelsAsync();
        StateHasChanged();
    }

    /// <summary>The hostels (the filter) and any Cloudbeds couldn't reach, for the current view.</summary>
    private async Task LoadHostelsAsync()
    {
        try
        {
            _hostels = await Api.Send(new GetHostelBookingHostels { View = _view, CheckInFrom = From, CheckInTo = To });
        }
        catch (AppException)
        {
            // The table says what went wrong.
        }
    }

    private DateOnly? From => _view == HostelBookingsView.All && _checkIn?.Start is { } start ? DateOnly.FromDateTime(start) : null;
    private DateOnly? To => _view == HostelBookingsView.All && _checkIn?.End is { } end ? DateOnly.FromDateTime(end) : null;

    private bool _loading;

    /// <summary>Asking every hostel's Cloudbeds takes a moment: the page says so above the table meanwhile.</summary>
    private async Task<PagedResult<HostelBookingRow>> LoadAsync(GridRequest request, CancellationToken cancellationToken)
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            return await Api.Send(request.Apply(new SearchHostelBookings { View = _view, Hostel = _hostel, CheckInFrom = From, CheckInTo = To }), cancellationToken);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SwitchAsync(HostelBookingsView view)
    {
        _view = view;
        await ReloadAsync();
    }

    private Task SetHostelAsync(string? hostel) { _hostel = hostel; return _table!.ReloadAsync(); }

    /// <summary>Once both dates are picked (the picker closes itself); a half-picked range waits.</summary>
    private Task SetCheckInAsync(DateRange? range)
    {
        _checkIn = range;
        return range is { Start: not null, End: not null } ? ReloadAsync() : Task.CompletedTask;
    }

    /// <summary>The table first (it shows it's loading while Cloudbeds is asked), then the hostels, which it has just fetched.</summary>
    private async Task ReloadAsync()
    {
        _expanded.Clear();
        await _table!.ReloadAsync();
        await LoadHostelsAsync();
    }

    /// <summary>A reservation number is only unique within its hostel's Cloudbeds.</summary>
    private static string Key(HostelBookingRow row) => $"{row.Hostel}/{row.ReservationId}";

    private void ToggleDetails(HostelBookingRow row)
    {
        if (!_expanded.Remove(Key(row)))
            _expanded.Add(Key(row));
    }

    // As a guest's hostel stays: green in house, red cancelled or no show.
    private static string Tone(string status) => status switch
    {
        "In house" => "good",
        "Confirmed" or "Checked out" => "neutral",
        "Not confirmed" => "warn",
        _ => "bad",
    };
}
