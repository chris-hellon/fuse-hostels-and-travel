@* Legacy BookingSummary (a centred card), with the pack and departure times added. *@

<MudPaper Elevation="2" Class="booking-summary">
    <div class="text-center">
        <MudText Typo="Typo.h6" Class="mb-2">Booking Summary</MudText>
        <MudText Typo="Typo.subtitle2">Booking is ready to be saved!</MudText>
        <MudText Typo="Typo.subtitle2">Review the summary below, then click Save to finish.</MudText>
    </div>

    <MudDivider Class="my-4" />
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4" Class="text-center">
            <MudText Typo="Typo.subtitle1" Class="booking-summary__label">Primary Guest:</MudText>
            <MudText Typo="Typo.body2">@(E.GuestName ?? "-")</MudText>
        </MudItem>
        <MudItem xs="12" sm="4" Class="text-center">
            <MudText Typo="Typo.subtitle1" Class="booking-summary__label">Total Amount:</MudText>
            <MudText Typo="Typo.body2">
                @E.Total.ToString("$#,##0.00") USD
                @if (!Draft.IsCreate && E.Total != E.SavedTotal)
                {
                    <span class="mud-text-secondary">(was @E.SavedTotal.ToString("$#,##0.00"))</span>
                }
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="4" Class="text-center">
            <MudText Typo="Typo.subtitle1" Class="booking-summary__label">Payment Method:</MudText>
            <MudText Typo="Typo.body2">@E.PaymentMethod</MudText>
        </MudItem>
    </MudGrid>
    <MudDivider Class="mt-4 mb-2" />

    @if (Draft.Pack is { } pack || Draft.Packages.Any())
    {
        <div class="booking-summary__extras">
            @if (Draft.Pack is { } marked)
            {
                <span class="booking-summary__tag">
                    <MudIcon Icon="@Icons.Material.Filled.Loyalty" Size="Size.Small" />
                    @marked.Name@(marked.Tiers.FirstOrDefault(t => t.Id == E.PackIncentiveTierId) is { } tier ? $" ({tier.Title})" : "")
                </span>
            }
            @foreach (var package in Draft.Packages)
            {
                <span class="booking-summary__tag">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                    @package.PackageName@(package.TierTitle is null ? "" : $" ({package.TierTitle})")
                </span>
            }
        </div>
    }

    <MudSimpleTable Dense="true" Elevation="0" Class="booking-summary__table admin-plain-table">
        <thead>
            <tr>
                <th>Tour</th>
                <th>Start</th>
                <th>End</th>
                <th class="text-right">Total Guests</th>
                <th class="text-right">Total Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in E.Lines.OrderBy(l => l.StartDate))
            {
                <tr @key="line.Key">
                    <td>@line.TourName</td>
                    <td>@line.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@line.EndDate?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-right">@line.GuestCount</td>
                    <td class="text-right">@line.Total.ToString("$#,##0.00")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    [Parameter, EditorRequired] public BookingDraft Draft { get; set; } = null!;

    private BookingEditor E => Draft.Editor;
}
