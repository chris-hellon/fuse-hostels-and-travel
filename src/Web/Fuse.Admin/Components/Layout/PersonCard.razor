<MudCard Elevation="0" Square="true" Class="@Class" Style="@Style">
    <MudCardHeader style="padding:10px!important">
        <CardHeaderAvatar>
            @if (string.IsNullOrEmpty(ImageUri))
            {
                <MudAvatar Size="Size.Medium" Color="Color.Primary" Class="ma-2">@FullName?.ToUpperInvariant().FirstOrDefault()</MudAvatar>
            }
            else
            {
                <MudAvatar><MudImage Src="@ImageUri" /></MudAvatar>
            }
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.body1">@FullName</MudText>
            <MudText Typo="Typo.caption">@Email</MudText>
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private string? FullName, Email, ImageUri;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null)
            return;
        var user = (await AuthState).User;
        (FullName, Email, ImageUri) = (user.GetFullName(), user.GetEmail(), user.GetImageUrl());
    }
}
